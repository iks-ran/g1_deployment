<?xml version="1.0"?>
<package format="3">
  <name>g1_bringup</name>
  <version>0.2.0</version>
  <description>Unitree G1 bringup: joint states / odom TF / MID-360 lidar + IMU relay (C++ component), RViz.</description>
  <maintainer email="iks-ran@g.ecc.u-tokyo.ac.jp">leus</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>unitree_go</depend>
  <depend>unitree_hg</depend>
  <exec_depend>g1_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
