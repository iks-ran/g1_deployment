# The one RViz config of this workspace (g1.launch, g1_description display.launch). The fixed frame comes from
# each launch file (rviz2 -f): odom for bringup, pelvis for the offline URDF check.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.4
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar deskewed (/g1/cloud_deskewed)
      Enabled: true
      Topic:
        Value: /g1/cloud_deskewed
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds:
        Value: true
      Decay Time: 0
      Alpha: 0.6
      Position Transformer: XYZ
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar (/g1/cloud, livox_frame)
      Enabled: false
      Topic:
        Value: /g1/cloud
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds:
        Value: true
      Decay Time: 0
      Alpha: 0.6
      Position Transformer: XYZ
      Selectable: true
      Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (/g1/odom)
      Enabled: false
      Topic:
        Value: /g1/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 50
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
      Target Frame: pelvis
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 1016
  Width: 1850
  X: 70
  Y: 27
